<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 开机自启：车机通电即拉起桌面 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 联网：留给以后接天气/在线歌词用（地图走本机 App，不靠它） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- targetSdk 30+ 下按包名查其他 App（打开导航/音乐）必须声明 -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- GPS 车速 / 海拔 / 天气定位坐标（API 23+ 运行时申请，见 MainActivity） -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!--
      包可见性（Android 11+）。
      只给 QUERY_ALL_PACKAGES 在某些 ROM 上仍会被拦，这里再补一条「所有带启动入口的 App」
      的静默查询声明。两条一起上，CarBridge.hasApp() 才在各种车机上都靠得住。
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|keyboardHidden|uiMode|density|layoutDirection"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape">
            <!--
              LAUNCHER：普通启动图标
              HOME：可在车机「默认桌面」里选它（设为主屏后，按 Home 键回到本桌面）
              设为主屏后如果界面出问题，风险是「Home 键一直回到这里」——
              所以设置面板里留了「系统设置」逃生按钮，能进系统设置改回原桌面。
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!--
          媒体信息读取（原装桌面显示歌名的同款原理）：
          用户在「设置 → 通知使用权」里允许后，TigerNLService 拿得到
          MediaSession 的歌名/歌手/播放状态，推给桌面音乐卡。
          只读媒体会话，不碰通知正文内容。
        -->
        <service
            android:name=".TigerNLService"
            android:exported="true"
            android:label="车机桌面媒体读取"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
