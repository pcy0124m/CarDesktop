# 换行符统一策略。
# 不写这个文件的话，Windows 上提交会让 Git 把 gradlew 也存成 CRLF，
# 到了 Linux runner 上就报 `./gradlew: /bin/sh^M: bad interpreter`——CI 必挂。

# 仓库内文本统一 LF
* text=auto eol=lf

# Windows 批处理必须 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
gradlew.bat text eol=crlf

# Gradle Wrapper 的 shell 脚本必须 LF（另一个名字是 .bat）
gradlew text eol=lf
*.sh text eol=lf

# 二进制：别碰
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.keystore binary
*.jks binary
*.zip binary
*.apk binary
*.aab binary
